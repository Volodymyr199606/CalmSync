# Database - PostgreSQL (Supabase recommended)
# Get your connection string from: https://supabase.com/dashboard/project/_/settings/database
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Supabase Auth (required for magic link login)
# Project Settings → API: Project URL + anon public key
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# App URL for magic link redirects (production)
NEXT_PUBLIC_APP_URL="https://calmsync.vercel.app"

# NextAuth Configuration (NextAuth v5 uses AUTH_SECRET, but NEXTAUTH_SECRET also works)
# Generate with: openssl rand -base64 32
# Or in PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
AUTH_SECRET="your-super-secret-32-character-minimum-string"
NEXTAUTH_SECRET="your-super-secret-32-character-minimum-string"  # Backward compatibility
NEXTAUTH_URL="http://localhost:3000"

# Email - Resend for Magic Link Authentication
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="onboarding@resend.dev"

# Sentry (Optional - for error monitoring)
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# AI Image Generation (Optional - for dashboard background images)
# Option 1: OpenAI DALL-E 3 (recommended for AI-generated images)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Option 2: Unsplash API (free alternative, requires attribution in production)
# Get your API key from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY="your-unsplash-access-key-here"
# Note: If neither API key is provided, the app will use Unsplash Source (free but less reliable)

